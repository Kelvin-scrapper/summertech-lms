# --- Database (PostgreSQL) ---
# Local dev with Docker:
#   docker run --name summertech-lms-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=summertech_lms -p 5433:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/summertech_lms?schema=public"

# --- Auth ---
# Secret for signing session + magic-link JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of this app (used to build magic-link URLs).
APP_URL="http://localhost:3001"

# --- Email (magic links) ---
# If unset, magic-link URLs are printed to the server console (fine for local dev).
RESEND_API_KEY=""
EMAIL_FROM="Summertech <login@summertech.ac.ke>"

# --- File uploads (lesson videos / PDFs / slides) ---
# Vercel Blob storage. Create a store in the Vercel dashboard (Storage -> Blob)
# and paste the read-write token. If unset, file upload is disabled and tutors
# can still attach resources by URL (YouTube, Google Drive, etc.).
BLOB_READ_WRITE_TOKEN=""
